# Copy to deploy/.env. One deployment per network: its data in
# deploy/state/<network>/, its own compose project (lexit-<network>).

# Bitcoin: regtest, mutinynet, signet or testnet4 (mutinynet's 30 s blocks
# make a dispute take minutes)
NETWORK=mutinynet

# Liquid: testnet (or liquid, for production: then run your own node,
# docs/RUN_A_HUB.md), read from its Esplora (empty: Blockstream's public
# one; a busy hub hosts its own)
LIQUID=testnet
LIQUID_ESPLORA=

# the deployment's image (deploy/build.sh builds it)
#LEXIT_IMAGE=lexit:latest

# regtest only: COMPOSE_PROFILES=regtest adds a miner, a block every
# MINE_EVERY seconds
COMPOSE_PROFILES=
MINE_EVERY=5

# the statement an exit's dispute runs: the hub's real proof that a claim
# is false, checked by BABE (hub-proves), or a mock of it, for trials
# (hub-proves-mock)
STATEMENT=hub-proves

# an absolute path on this machine for the Groth16 wrap's working files
# (mounted at the same path in the hub's container). Empty: deploy/lexit.sh
# uses deploy/state/<network>/r0work
R0WORK=

# the hub's terms. Its fee, kept out of the L-BTC it pays at the opening:
# a yearly rate (parts per million) on that L-BTC (D) and on the BTC it
# locks beyond it (the liquidity), for the contract's term, and a flat
# part (sats). Its reserve (ppm of the cap); the most liquidity a contract
# may ask (sats); a contract's life in blocks (empty: the network's
# default); a warning below this much L-BTC (sats)
DEPOSIT_PPM_YEAR=30000
LIQUIDITY_PPM_YEAR=50000
FLAT_FEE=0
RESERVE_PPM=20000
MAX_LIQUIDITY=10000000
DURATION=
FLOAT_WARN=1000000

# for trials, on test networks only: any value makes the hub refuse every
# cooperative withdrawal and assert a forged proof against every exit
# claim, true ones too, so that users challenge and win
HOSTILE=
# for trials, on test networks only: any value makes the hub refuse every
# cooperative withdrawal but assert only against false claims
REFUSE_FOLDS=

# the hub's published port
HUB_PORT=18330
